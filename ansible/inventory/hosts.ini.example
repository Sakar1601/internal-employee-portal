; Generate this file for real with:
;   terraform -chdir=../terraform output -raw portal_public_ip
; then fill in the value below. The portal instance sits in the public
; subnet (directly reachable over SSH from your IP) — only RDS is in the
; private, no-IGW subnets. See docs/architecture.md.

[web]
portal ansible_host=REPLACE_WITH_TERRAFORM_OUTPUT ansible_user=ec2-user ansible_ssh_private_key_file=../secrets/portal-lab-ssh-key
