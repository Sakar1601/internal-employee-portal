[Unit]
Description=Internal Employee Portal
After=network.target

[Service]
Type=simple
User=portal
Group=portal
EnvironmentFile=/etc/portal/portal.env
WorkingDirectory=/opt/portal/backend
ExecStart=/opt/portal/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile /etc/portal/tls/key.pem --ssl-certfile /etc/portal/tls/cert.pem
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/portal/backend

[Install]
WantedBy=multi-user.target
